+     * mistakes and are ignored. Filtering happens in {@link Instant} space here
+     * because the analysis reads the recording with {@code jdk.jfr.consumer}.
+     */
+    private static Instant parseInstant(String raw) {
+        if (raw == null || raw.isBlank()) {
+            return null;
+        }
+        try {
+            return Instant.parse(raw);
+        } catch (Exception ignored) {
+            // fall through to numeric interpretation
+        }
+        try {
+            long numeric = Long.parseLong(raw.strip());
+            if (numeric >= EPOCH_MS_THRESHOLD) {
+                return Instant.ofEpochMilli(numeric);
             }
+            if (numeric >= MIN_VALID_EPOCH_SECONDS) {
+                return Instant.ofEpochSecond(numeric);
+            }
+            return null;
+        } catch (NumberFormatException ignored) {
+            return null;
+        }
+    }
